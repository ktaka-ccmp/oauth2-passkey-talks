flowchart TD
    BROWSER["Browser"]
    
    subgraph AXUM["oauth2_passkey_axum"]
        direction TB
        R["Router"]
        H["Handlers"]
        U["Static Assets (UI)"]
        R --> H
        H --> U
    end

    subgraph CORE["oauth2_passkey"]
        direction TB
        C["coordination<br>(orchestrates flows)"]
        
        M["[Modules]<br>oauth2, passkey, session, userdb"]
        
        S["[Storage]<br>cache_store, data_store"]
        
        C --> M
        M --> S
    end

    MEM[("Memory / Redis")]
    SQL[("SQLite / PgSQL")]

    BROWSER -->|HTTP Request| R
    H -->|calls| C
    S -.-> MEM
    S -.-> SQL

    style AXUM fill:#e3f2fd,stroke:#1565c0
    style CORE fill:#fff3e0,stroke:#e65100
