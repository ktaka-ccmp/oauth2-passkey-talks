graph TB
    subgraph APP["Your Axum App"]
        H[Handlers]
        R[Router]
    end

    subgraph AXUM["oauth2-passkey-axum"]
        AR[Router Setup]
        AU[AuthUser Extractor]
        MW[Middleware<br/>is_authenticated_*]
        CSRF[CSRF Protection]
        UI[Login UI<br/>optional]
    end

    subgraph CORE["oauth2-passkey"]
        COORD[Coordination Layer]
        O2[OAuth2 Module]
        PK[Passkey Module]
        SESS[Session Module]
        UDB[User DB Module]
        subgraph STORAGE["Storage Layer"]
            DS[DataStore Trait]
            CS[CacheStore Trait]
            SQ[SQLite]
            PG[PostgreSQL]
            MY[MySQL]
            MEM[Memory Cache]
            RED[Redis]
        end
    end

    R --> AR
    H --> AU
    H --> MW
    AR --> COORD
    AU --> SESS
    MW --> SESS
    COORD --> O2
    COORD --> PK
    COORD --> SESS
    COORD --> UDB
    O2 --> DS
    PK --> DS
    UDB --> DS
    SESS --> CS
    DS --> SQ
    DS --> PG
    DS --> MY
    CS --> MEM
    CS --> RED

    style APP fill:#e8f5e9,stroke:#2e7d32
    style AXUM fill:#e3f2fd,stroke:#1565c0
    style CORE fill:#fff3e0,stroke:#e65100
    style STORAGE fill:#fce4ec,stroke:#c62828
